+export async function fetchHealth(): Promise<{ status: string; now: string; version: string }> {
+  const response = await fetch(`${API_BASE}/api/health`, { headers: authHeaders() });
+  const body = await response.json();
+  if (!body.success) throw new Error(body.error || "Failed to fetch health");
+  return body.data!;
+}
